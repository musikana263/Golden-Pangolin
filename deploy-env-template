# Golden Pangolin — production .env
# Replace every <placeholder> with a real value, save the file, then visit
# https://goldenpangolin.com/install.php

APP_NAME="Golden Pangolin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://goldenpangolin.com
APP_TIMEZONE=Africa/Harare
ASSET_URL=https://goldenpangolin.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database — from DirectAdmin → MySQL Management
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<your_db_name>
DB_USERNAME=<your_db_user>
DB_PASSWORD=<your_db_password>

# Sessions / cache / queue — file/sync chosen because the project does not
# ship sessions/jobs/cache_locks migrations. Switching to database here would
# 500 every request with "Table 'sessions' doesn't exist".
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.goldenpangolin.com
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log

# Mail — leave on `log` until you set up Postmark.
# When ready, switch to MAIL_MAILER=postmark and paste your server token.
MAIL_MAILER=log
POSTMARK_TOKEN=
MAIL_FROM_ADDRESS="hello@goldenpangolin.com"
MAIL_FROM_NAME="Golden Pangolin"

# Where contact-form submissions are emailed. Leave blank to use MAIL_FROM_ADDRESS.
CONTACT_NOTIFY_TO=info@goldenpangolin.com

# Seeded admin account (used by install.php once, then ignored)
SEED_ADMIN_EMAIL=info@goldenpangolin.com
SEED_ADMIN_PASSWORD=GoldP@2026
SEED_ADMIN_NAME=Administration

# Login OTP second factor
OTP_LOGIN_ENABLED=true

# Security
BCRYPT_ROUNDS=12

# Site
SITE_BRAND="Golden Pangolin"
SITE_WHATSAPP_NUMBER=26371527381
